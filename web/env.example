# Web Frontend Environment Configuration
# Copy this file to .env.local and update with your values

# Backend API Configuration
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_API_URL_PROD=https://your-production-api.com/api

# Supabase Configuration (shared with mobile)
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# Authentication Configuration
REACT_APP_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
REACT_APP_PASSWORD_MIN_LENGTH=8
REACT_APP_SESSION_TIMEOUT=60
REACT_APP_MAX_LOGIN_ATTEMPTS=5

# Social Authentication
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id
REACT_APP_APPLE_CLIENT_ID=your-apple-client-id

# Feature Flags
REACT_APP_ENABLE_2FA=true
REACT_APP_ENABLE_SOCIAL_LOGIN=true
REACT_APP_ENABLE_MAGIC_LINKS=true

# Development/Debug
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=info

# Development ports (for documentation)
# Frontend: http://localhost:3000
# Backend: http://localhost:8000
# Mobile: http://localhost:8082
